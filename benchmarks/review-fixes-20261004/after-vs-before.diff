+#[test]
+fn cold_generic_run_batches_atlas_target_changes_and_preserves_state() {
+    let face = swash::FontRef::from_index(FONT, 0).unwrap();
+    #[cfg(feature = "swash")]
+    let modes = [RenderMode::Stroke];
+    #[cfg(not(feature = "swash"))]
+    let modes = [RenderMode::Fill, RenderMode::Stroke];
+    for mode in modes {
+        for kind in 0..3 {
+            let (mut canvas, font) = canvas();
+            let paint = Paint::color(Color::black()).with_font_size(24.0).with_line_width(1.25);
+            let draw = |canvas: &mut Canvas<RecordingRenderer>, glyphs: Vec<PositionedGlyph>| match mode {
+                RenderMode::Fill => canvas.fill_glyph_run(font, &[], glyphs, &paint),
+                RenderMode::Stroke => canvas.stroke_glyph_run(font, &[], glyphs, &paint),
+            };
+            // Initialize the texture first: debug inspector may clear it in
+            // its own pass. The following four glyphs are still atlas misses.
+            draw(&mut canvas, vec![glyph(face.charmap().map('A'), 10.0)]).unwrap();
+            let target = select_target(&mut canvas, kind);
+            canvas.translate(7.0, 11.0);
+            let transform = canvas.transform();
+            let state_depth = canvas.state_stack.len();
+            let layer_count = canvas.layers.len();
+            canvas.commands.clear();
+            let glyphs = ['B', 'C', 'D', 'E']
+                .into_iter()
+                .enumerate()
+                .map(|(index, ch)| glyph(face.charmap().map(ch), 10.0 + index as f32 * 30.0))
+                .collect();
+            draw(&mut canvas, glyphs).unwrap();
+            assert_eq!(canvas.glyph_atlas.rendered_glyphs.borrow().len(), 5);
+            assert_eq!(canvas.glyph_atlas.glyph_textures.borrow().len(), 1);
+            let switches = canvas
+                .commands
+                .iter()
+                .filter_map(|command| match command.cmd_type {
+                    crate::renderer::CommandType::SetRenderTarget(target) => Some(target),
+                    _ => None,
+                })
+                .collect::<Vec<_>>();
+            assert_eq!(switches.len(), 2, "one atlas pass for all four cold glyphs");
+            assert_eq!(switches[1], target);
+            assert_ne!(switches[0], target);
+            assert_eq!(canvas.current_render_target, target);
+            assert_eq!(canvas.layers.len(), layer_count);
+            assert_eq!(canvas.state_stack.len(), state_depth);
+            assert_eq!(canvas.transform(), transform);
+        }
+    }
+}
