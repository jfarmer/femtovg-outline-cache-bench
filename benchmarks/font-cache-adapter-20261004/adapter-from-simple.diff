+        font_size: f32,
+        glyph_id: u16,
+        subpixel_x: f32,
+        normalized_coords: &[i16],
+    ) -> Option<Image> {
+        self.state
+            .borrow_mut()
+            .render(font, font_size, glyph_id, subpixel_x, normalized_coords)
+    }
+
+    // Swash-only fonts share this native context for their generic fallback.
+    #[cfg(not(feature = "textlayout"))]
+    pub(super) fn scale_context(&self) -> Rc<RefCell<ScaleContext>> {
+        Rc::clone(&self.state.borrow().scale_context)
+    }
