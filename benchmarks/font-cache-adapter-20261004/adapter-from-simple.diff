+pub(super) struct SwashRasterizer {
+    state: Rc<RefCell<RasterizerState>>,
+}
+
+impl Default for SwashRasterizer {
+    fn default() -> Self {
+        let context = Rc::new(RefCell::new(ScaleContext::new()));
+        Self {
+            state: Rc::new(RefCell::new(RasterizerState::new(context))),
+        }
+    }
